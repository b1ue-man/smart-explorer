# Rust build output (huge, regenerable)
native/target/
native/explorer-command/target/
/native/.Cargo.lock.complete-release-version.*
/native/.Cargo.toml.complete-release-version.*

# Graphify project graph lives at /graphify-out; it is generated per clone
# (AGENTS.md, graphify) and not versioned. Avoid accidental nested runs.
/graphify-out/
native/src/graphify-out/
.codex/
graphify-out/cache/

# Built binaries & generated installer artifacts
*.exe
release-native/Smart Explorer*.exe

# OS / editor cruft
Thumbs.db
.DS_Store
*.swp

# EXCEPTION: release-native/update-feed/ stays committed at v0.5.192 as the
# bridge for installs up to 0.5.190, which read it over raw.githubusercontent.com;
# every later version reads the GitHub release feed. (Negation must come after
# the *.exe rule.)
!release-native/update-feed/
!release-native/update-feed/version.txt
!release-native/update-feed/smart_explorer.exe
!release-native/update-feed/smart_explorer.exe.sha256
!release-native/update-feed/smart_explorer_updater.exe
!release-native/update-feed/smart_explorer_updater.exe.sha256
!release-native/update-feed/se.exe
!release-native/update-feed/se.exe.sha256
!release-native/update-feed/se-mcp-launcher.exe
!release-native/update-feed/se-mcp-launcher.exe.sha256
release-native/update-feed/versions/
# Installers, portable programs, the share server and the context-menu DLL are
# release assets only (.github/workflows/release.yml); they are never committed.
release-native/share-server/
release-native/smart_explorer_command.dll

# Complete-release locks, rollback copies, and failure-preserved candidates are
# local recovery state. Never stage them as release assets.
/release-native/.complete-release.lock
/release-native/.release-stage.*
/release-native/.complete-release-stage.*
/release-native/.update-feed.release-new.*
/release-native/.update-feed.release-backup.*
/release-native/.update-feed.linux-candidate.*
/release-native/.update-feed.backup.*
/release-native/.*.release-new.*
/release-native/.*.release-backup.*
/release-native/.se-share-server-linux.stage.*
/release-native/share-server/.se-share-server-linux.stage.*
/release-native/share-server/.se-share-server-linux.release-new.*
/release-native/share-server/.se-share-server-linux.backup.*
/release-native/share-server/.*.release-new.*
/release-native/share-server/.*.release-backup.*
/release-native/windows-partial-v*/
# Running a feed updater in place may create its private rollback archive.
# It is local runtime state, never part of the committed update feed.
/release-native/update-feed/versions/

# Standalone se-agent crate build artifacts (the built binaries are committed
# under native/agent-bin/, not these).
/se-agent/target/
