*.sh text eol=lf
# Published administration asset: Windows and Linux hash the same source bytes.
/native/install-login-service.ps1 text eol=lf
release-native/update-feed/*.sha256 text eol=lf
release-native/update-feed/version.txt text eol=lf
release-native/update-feed/windows-build.manifest text eol=lf
# Preserve the exact remote-approved dependency bytes, including JSON line endings.
/native/assets/dokany-private/* -text
# Android Gradle wrapper: POSIX script must keep LF, Windows script CRLF, the verified jar is binary.
/android/gradlew text eol=lf
/android/gradlew.bat text eol=crlf
*.jar binary

# Embedded AI agent skill: identical bytes on every platform (include_str!).
/native/src/cli/plugin/assets/* text eol=lf

# Embedded crate license texts (native/src/licenses, include_str!): LF everywhere.
third-party/rust-crates/THIRD-PARTY-LICENSES.txt text eol=lf

# Cisco OpenH264 binary license: word for word, no line-end conversion (SHA-256 pinned in screen/core/licenses.rs).
/third-party/openh264/BINARY_LICENSE.txt -text
