+BOOL DokanSubmitThreadpoolWork(PDOKAN_INSTANCE DokanInstance,
+                               PTP_WORK_CALLBACK Callback, PVOID Context) {
+  BOOL submitted = FALSE;
+  DWORD error = ERROR_OPERATION_ABORTED;
+  // Protect creation AND submission. Cleanup cannot release a work object
+  // between CreateThreadpoolWork and SubmitThreadpoolWork.
+  EnterCriticalSection(&DokanInstance->CriticalSection);
+  if (!DokanInstance->WorkSubmissionClosed) {
+    PTP_WORK work = CreateThreadpoolWork(
+        Callback, Context, &DokanInstance->ThreadInfo.CallbackEnvironment);
+    if (work) {
+      SubmitThreadpoolWork(work);
+      submitted = TRUE;
+    } else {
+      error = GetLastError();
+    }
+  }
+  LeaveCriticalSection(&DokanInstance->CriticalSection);
+  if (!submitted) SetLastError(error);
+  return submitted;
+}
