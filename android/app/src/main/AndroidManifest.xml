<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground services: transfers (dataSync) and optional permanent background mode (specialUse) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- This phone as screen host (SCR-M8): capture after the system dialog „Bildschirm teilen“ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Notifications (runtime permission on API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot restart of the permanent background mode and periodic work -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- All-files access: the core works on real file paths of every mounted volume -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Network, discovery and power -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Short partial wake locks for Share activity and keep-alive probes while the screen is off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Optional usage access: sizes of other apps' folders in the storage analysis
         (StorageStatsManager); granted by the user in the settings, never requested at runtime. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Every installed app for "≈ Apps (laut Android)" in the storage analysis (normal permission;
         package visibility would otherwise hide most apps and their storage). The app is not
         distributed through Google Play. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Self-update through the system installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- VLT-M11 (U31, S1): the remembered vault password opens only after the device lock
         confirms it (android.hardware.biometrics.BiometricPrompt, biometrics or PIN). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- DSK-M10 (U35): the launcher's „Deinstallieren“ starts ACTION_DELETE (from targetSdk 28 on, the
         system uninstaller refuses callers without this normal permission). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- DSK-M9 (U35): the private space (API 35+) is only visible to the default home app that holds this normal permission. -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />

    <!-- Connections, jobs and the share identity never leave the device (cloud backup and
         device transfer are both disabled / fully excluded). -->
    <application
        android:name=".SmartExplorerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartExplorer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- "In Smart Explorer öffnen": folders only (DocumentsContract.Document.MIME_TYPE_DIR; the two
                 other types are sent by some file managers). A MIME-only filter covers content: and
                 file: URIs; files are deliberately not claimed, so the app is not offered as a viewer. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.document/directory" />
                <data android:mimeType="resource/folder" />
                <data android:mimeType="inode/directory" />
            </intent-filter>
        </activity>

        <!-- The se launcher (DSK-M9, U35): off until the person switches it on in the settings (component
             state), runs in its own process without the Rust core. Exactly one filter, so it is offered
             in the system's list of home screens only while enabled. -->
        <activity
            android:name=".launcher.LauncherActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|fontScale|keyboard|keyboardHidden|navigation|layoutDirection|locale|colorMode"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/launcher_label"
            android:launchMode="singleTask"
            android:process=":launcher"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SmartExplorer.Launcher"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Transfers, "run now" sync runs and the Google sign-in while the UI was left -->
        <service
            android:name=".service.TaskForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Background service: permanent background mode or "Share im Hintergrund erreichbar"
             (both user opt-in); boot-startable type -->
        <service
            android:name=".service.BackgroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps user-configured folder synchronization jobs running and the device-sharing endpoint reachable for the user's paired devices while the user has enabled the permanent background mode or background reachability of sharing" />
        </service>

        <!-- WorkManager's own service: the periodic sync worker promotes itself with dataSync -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- "Stopp" in the notification of a command another device runs on this phone -->
        <receiver
            android:name=".service.ExecHostStopReceiver"
            android:exported="false" />

        <!-- "Diesmal erlauben", "Immer erlauben", "Ablehnen" in the notification of another device's
             question (explicit immutable PendingIntents of this app only) -->
        <receiver
            android:name=".service.AccessApprovalReceiver"
            android:exported="false" />

        <!-- The same question as a dialog while the app is visible; started only from the app itself -->
        <activity
            android:name=".ui.share.AccessApprovalActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- This phone as screen host (SCR-M8). The consent activity answers a screen question and
             asks the system dialog; only intents of this app start it (activity PendingIntents of
             the question and the session notification). -->
        <activity
            android:name=".screen.ScreenConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Captures only with the token of the system dialog; its notification and the status bar
             chip show that the screen is watched -->
        <service
            android:name=".screen.ScreenHostService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <!-- Switched on only by the user in the Android settings; the system alone may bind it -->
        <service
            android:name=".screen.ScreenControlService"
            android:exported="true"
            android:label="@string/screen_control_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/screen_control_service" />
        </service>
        <!-- Wake alarm of the background service (explicit PendingIntent only) -->
        <receiver
            android:name=".system.KeepAliveReceiver"
            android:exported="false" />
        <receiver android:name=".system.SyncScheduleReceiver" android:exported="false" />

        <receiver
            android:name=".system.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Local files opened in other apps: only paths below reported volumes, writes go to the original -->
        <provider
            android:name=".system.LocalFileProvider"
            android:authorities="${applicationId}.localfiles"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- „Ordner für Apps bereitstellen“ (DRV-M8): devices, released connections and unlocked
             vaults in the system picker. Off until the person switches it on (component state);
             only the system (MANAGE_DOCUMENTS) binds it, other apps get the single URIs picked. -->
        <provider
            android:name=".system.documents.SeDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:enabled="false"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Cache copies only (remote files to open/share, downloaded update APK) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
