<?xml version="1.0" encoding="utf-8"?>
<!-- Connections, credentials, sync jobs and the private share identity stay on this device:
     nothing is included in cloud backups or device-to-device transfers (API 31+). On API 30
     android:allowBackup="false" disables backups entirely. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
